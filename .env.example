# Copy these values into environment variables; .env is NOT loaded automatically.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Langfuse is opt-in: --trace. Input and report content are NOT sent by our spans.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Build a flow in Langflow first; see docs/LANGFLOW.md.
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
